[Unit]
Description=Payam Logger - background screenshot service
# Bound to the graphical session: screenshots need the session's D-Bus and
# the running compositor. Starts with login, stops at logout.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Config is picked up automatically from
# ~/.config/payam-logger/config.json when it exists.
ExecStart=%h/.local/bin/payam-loggerd
Restart=on-failure
RestartSec=5

# Hardening (kept light: user service, needs session D-Bus and data dir)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
